{
  "mcpServers": {
    "gitcode": {
      "command": "__PREFIX__/current/venv/bin/gitcode-api",
      "args": ["serve"],
      "env": {
        "GITCODE_ACCESS_TOKEN": "${GITCODE_ACCESS_TOKEN}"
      },
      "description": "GitCode REST API: repositories, forks, branches, contents, issues and pull requests"
    }
  }
}
